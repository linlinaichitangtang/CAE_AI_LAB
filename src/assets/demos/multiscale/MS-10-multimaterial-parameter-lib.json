          }
        },
        "reference_data_source": "MD MS-10 Step 2"
      },
      "output": {
        "phase_field_parameters_library": "pf_params_library.json",
        "validation_results": {
          "interface_stability_check": "all_materials_stable",
          "numerical_stability_CFL": "all_materials_satisfy_CFL",
          "grid_convergence": "all_materials_converged",
          "parameter_physical_range_check": "all_within_physical_bounds"
        },
        "simulation_settings": {
          "metals": {
            "model": "Allen-Cahn",
            "grid_spacing": 0.1,
            "grid_spacing_unit": "nm",
            "time_step": 1.0,
            "time_step_unit": "ns"
          },
          "ceramics": {
            "model": "Phase_field_fracture_AT2",
            "grid_spacing": 0.05,
            "grid_spacing_unit": "nm",
            "time_step": 0.1,
            "time_step_unit": "ns"
          },
          "polymers": {
            "model": "Allen-Cahn_Cahn-Hilliard_coupled",
            "grid_spacing": 1.0,
            "grid_spacing_unit": "nm",
            "time_step": 10.0,
            "time_step_unit": "ns"
          }
        }
      },
      "parameters": {
        "validation_tests": [
          "interface_width_resolution_check",
          "gradient_energy_stability",
          "mobility_positive_definite",
          "driving_force_consistency",
          "CFL_condition_satisfied",
          "mass_conservation_check",
          "energy_dissipation_check"
        ],
        "tolerances": {
          "interface_width_error": 10,
          "gradient_energy_error": 15,
          "mobility_error": 20,
          "numerical_stability": 5
        },
        "tolerances_unit": "percent"
      },
      "bridge_to_next": {
        "mapping_method": "Phase field effective properties to FE constitutive parameters",
        "data_transferred": [
          "effective_elastic_properties",
          "fracture_parameters",
          "transformation_parameters",
          "viscoelastic_parameters"
