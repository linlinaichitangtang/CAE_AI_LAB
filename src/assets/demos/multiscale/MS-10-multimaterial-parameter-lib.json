              "interface_width": 0.7,
              "interface_width_unit": "nm",
              "gradient_energy_coefficient": 1.3e-9,
              "gradient_energy_coefficient_unit": "J/m",
              "mobility": 2.0e-14,
              "mobility_unit": "m^3/(J*s)",
              "driving_force": 1.2e9,
              "driving_force_unit": "J/m^3"
            }
          },
          "ceramics": {
            "Al2O3": {
              "interface_width": 0.3,
              "interface_width_unit": "nm",
              "gradient_energy_coefficient": 5.0e-10,
              "gradient_energy_coefficient_unit": "J/m",
              "mobility": 1.0e-16,
              "mobility_unit": "m^3/(J*s)",
