              "gradient_energy_coefficient_unit": "J/m",
              "mobility": 5.0e-16,
              "mobility_unit": "m^3/(J*s)",
              "fracture_energy_Gc": 65,
              "fracture_energy_unit": "J/m^2"
            },
            "ZrO2": {
              "interface_width": 0.5,
              "interface_width_unit": "nm",
              "gradient_energy_coefficient": 8.0e-10,
              "gradient_energy_coefficient_unit": "J/m",
              "mobility": 1.0e-15,
              "mobility_unit": "m^3/(J*s)",
              "fracture_energy_Gc": 40,
              "fracture_energy_unit": "J/m^2",
              "transformation_strain": 0.04
            }
          },
          "polymers": {
            "PE": {
              "interface_width": 5.0,
              "interface_width_unit": "nm",
              "gradient_energy_coefficient": 1.0e-8,
              "gradient_energy_coefficient_unit": "J/m",
              "mobility": 1.0e-12,
              "mobility_unit": "m^3/(J*s)",
              "crystallization_temperature": 414,
              "crystallization_temperature_unit": "K"
            },
            "PMMA": {
              "interface_width": 3.0,
              "interface_width_unit": "nm",
              "gradient_energy_coefficient": 8.0e-9,
              "gradient_energy_coefficient_unit": "J/m",
              "mobility": 5.0e-13,
              "mobility_unit": "m^3/(J*s)",
              "glass_transition_temperature": 378,
              "glass_transition_temperature_unit": "K"
            },
            "Epoxy": {
              "interface_width": 2.0,
              "interface_width_unit": "nm",
              "gradient_energy_coefficient": 5.0e-9,
              "gradient_energy_coefficient_unit": "J/m",
              "mobility": 1.0e-13,
              "mobility_unit": "m^3/(J*s)",
              "glass_transition_temperature": 453,
              "glass_transition_temperature_unit": "K",
              "crosslink_density": 2.8e3,
              "crosslink_density_unit": "mol/m^3"
