{
  "id": "MS-07",
  "name": "Al合金蠕变全链路",
  "nameEn": "Al Alloy Creep Full Chain",
  "description": "铝合金高温蠕变全链路多尺度模拟：从DFT计算铝的自扩散系数出发，通过分子动力学模拟晶界扩散行为，利用相场方法预测晶粒粗化动力学，最终通过有限元方法建立蠕变本构关系并预测宏观蠕变响应。该案例展示从原子扩散机制到工程蠕变寿命预测的完整多尺度链路，对高温结构材料设计具有重要参考价值。",
  "category": "multiscale",
  "usage": "demo",
  "difficulty": 4,
  "tags": ["creep", "diffusion", "grain boundary", "grain coarsening", "constitutive law", "Al alloy", "full chain"],
  "scales": ["dft", "md", "phase_field", "fe"],
  "material_system": "Al alloy",
  "pipeline_steps": [
    {
      "step": "dft",
      "name": "Al自扩散系数与空位形成能计算",
      "description": "使用DFT计算铝的空位形成能、迁移能垒和自扩散系数，为MD和蠕变模型提供基础参数",
      "input": {
        "crystal_structure": "FCC",
        "lattice_constant": 4.05,
        "lattice_constant_unit": "Angstrom",
        "atomic_number": 13,
        "supercell_vacancy": "3x3x3 (107 atoms + 1 vacancy)",
        "neb_images": 7
      },
      "output": {
        "vacancy_formation_energy": 0.66,
        "vacancy_formation_energy_unit": "eV",
        "vacancy_migration_barrier": 0.61,
        "migration_barrier_unit": "eV",
        "activation_energy_Q": 1.27,
        "activation_energy_unit": "eV",
        "pre_exponential_D0": 1.77e-4,
        "pre_exponential_unit": "m^2/s",
        "diffusion_coefficient_600K": 3.5e-14,
        "diffusion_coefficient_unit": "m^2/s",
        "vibration_frequency": 8.5,
        "vibration_frequency_unit": "THz",
        "attempt_frequency": 1.0e13,
        "attempt_frequency_unit": "Hz"
      },
      "parameters": {
        "k_points": [12, 12, 12],
        "energy_cutoff": 350,
        "energy_cutoff_unit": "eV",
        "pseudopotential": "PAW_PBE_Al",
        "xc_functional": "PBE",
        "smearing": "Methfessel-Paxton",
        "smearing_width": 0.2,
        "smearing_width_unit": "eV",
        "scf_convergence": 1e-8,
        "scf_convergence_unit": "eV",
        "neb_method": "CI-NEB",
        "neb_convergence": 0.05,
        "neb_convergence_unit": "eV/Angstrom",
        "phonon_method": "finite_displacement"
      },
      "bridge_to_next": {
        "mapping_method": "Activation energy and D0 to MD diffusion parameters and Arrhenius rate model",
        "data_transferred": [
          "vacancy_formation_energy",
          "vacancy_migration_barrier",
          "activation_energy_Q",
          "pre_exponential_D0",
          "attempt_frequency"
        ]
      }
    },
    {
      "step": "md",
      "name": "Al晶界扩散分子动力学模拟",
      "description": "使用EAM势函数模拟铝双晶模型中的晶界扩散行为，提取晶界扩散系数和扩散激活能",
      "input": {
        "bicrystal_model": "Sigma5(310)[001] symmetric tilt grain boundary",
        "block_dimensions": {
          "Lx": 10,
          "Ly": 20,
          "Lz": 10,
          "unit": "nm"
        },
        "atom_count": 80000,
        "grain_boundary_plane": "(310)",
        "misorientation_angle": 36.9,
        "misorientation_angle_unit": "degree",
        "temperatures": [400, 500, 600, 700],
        "temperatures_unit": "K",
        "activation_energy_DFT": 1.27,
        "activation_energy_unit": "eV"
      },
      "output": {
        "grain_boundary_energy": 0.53,
        "grain_boundary_energy_unit": "J/m^2",
        "gb_diffusion_coefficients": {
          "400K": 2.1e-17,
          "500K": 5.8e-16,
          "600K": 8.2e-15,
          "700K": 6.5e-14,
          "unit": "m^2/s"
        },
        "gb_diffusion_activation_energy": 0.85,
        "gb_activation_energy_unit": "eV",
        "gb_diffusion_pre_exponential": 3.2e-5,
        "gb_pre_exponential_unit": "m^2/s",
        "gb_width": 1.2,
        "gb_width_unit": "nm",
        "gb_migration_velocity": 0.5,
        "migration_velocity_unit": "nm/ns",
        "mean_square_displacement": "msd_gb.dat"
      },
      "parameters": {
        "potential": "EAM (Mishin Al)",
        "potential_file": "Al_mishin.eam.alloy",
        "timestep": 1,
        "timestep_unit": "fs",
        "ensemble": "NVT",
        "thermostat": "Nosé-Hoover",
        "thermostat_damping": 100,
        "thermostat_damping_unit": "fs",
        "equilibration_steps": 100000,
        "production_steps_per_temperature": 2000000,
        "dump_interval": 5000,
        "cutoff_radius": 6.5,
        "cutoff_radius_unit": "Angstrom",
        "msd_analysis": "per_atom_decomposed_gb_bulk"
      },
      "bridge_to_next": {
        "mapping_method": "GB diffusion coefficient and mobility to phase field grain boundary mobility",
        "data_transferred": [
          "gb_diffusion_activation_energy",
          "gb_diffusion_pre_exponential",
          "gb_energy",
          "gb_width",
          "gb_migration_velocity"
        ]
      }
    },
    {
      "step": "phase_field",
      "name": "Al合金晶粒粗化相场模拟",
      "description": "基于MD得到的晶界迁移率参数，使用多序参量相场模型模拟铝合金的晶粒粗化过程",
      "input": {
        "domain_size": {
          "Lx": 50,
          "Ly": 50,
          "Lz": 50,
          "unit": "um"
        },
        "grid_points": "256x256x256",
        "initial_grain_count": 500,
        "initial_mean_grain_size": 2.0,
        "initial_grain_size_unit": "um",
        "temperature": 600,
        "temperature_unit": "K",
        "gb_mobility_source": "MD grain boundary migration",
        "gb_energy_source": "MD grain boundary energy"
      },
      "output": {
        "grain_structure_evolution": "grain_evolution.vtk",
        "grain_size_vs_time": "grain_growth_kinetics.dat",
        "growth_exponent_n": 3.0,
        "growth_exponent_description": "normal_grain_growth",
        "grain_growth_rate_constant_k": 2.5e-15,
        "rate_constant_unit": "m^3/s",
        "final_mean_grain_size_100h": 8.5,
        "final_grain_size_unit": "um",
        "grain_size_distribution": "log_normal",
        "gb_area_per_volume": 4.2e5,
        "gb_area_unit": "m^-1",
        "texture_evolution": "texture_evolution.dat"
      },
      "parameters": {
        "model": "Multi-order-parameter Allen-Cahn grain growth",
        "order_parameters_count": 50,
        "interface_width": 0.15,
        "interface_width_unit": "um",
        "gradient_energy_coefficient": 6.24e-10,
        "gradient_energy_coefficient_unit": "J/m",
        "mobility": 2.8e-13,
        "mobility_unit": "m^3/(J*s)",
        "mobility_temperature_dependence": "Arrhenius",
        "mobility_activation_energy": 0.85,
        "mobility_activation_energy_unit": "eV",
        "gb_energy": 0.53,
        "gb_energy_unit": "J/m^2",
        "time_step": 1.0,
        "time_step_unit": "s",
        "total_time": 360000,
        "total_time_unit": "s",
        "noise_amplitude": 0.001,
        "thermal_fluctuation": true
      },
      "bridge_to_next": {
        "mapping_method": "Grain size and GB density to creep constitutive parameters (Nabarro-Herring/Coble creep)",
        "data_transferred": [
          "grain_size_distribution",
          "mean_grain_size_vs_time",
          "gb_area_per_volume",
          "grain_growth_kinetics",
          "texture_evolution"
        ]
      }
    },
    {
      "step": "fe",
      "name": "Al合金蠕变有限元分析",
      "description": "基于相场输出的晶粒尺寸演化，建立Norton蠕变本构模型epsilon_dot=A*sigma^n，进行宏观蠕变有限元预测",
      "input": {
        "specimen_geometry": {
          "gauge_length": 50,
          "gauge_diameter": 10,
          "unit": "mm"
        },
        "material": "Al-7075-T6",
        "youngs_modulus": 71.7,
        "youngs_modulus_unit": "GPa",
        "poisson_ratio": 0.33,
        "density": 2810,
        "density_unit": "kg/m^3",
        "creep_law": "Norton_power_law",
        "creep_parameters": {
          "A": 1.2e-12,
          "A_unit": "1/(MPa^n * s)",
          "n": 5.0,
          "Q_creep": 142,
          "Q_creep_unit": "kJ/mol"
        },
        "grain_size_source": "Phase field MS-07 Step 3",
        "applied_stress": 200,
        "applied_stress_unit": "MPa",
        "temperature": 600,
        "temperature_unit": "K"
      },
      "output": {
        "creep_curve": "creep_strain_vs_time.dat",
        "steady_state_creep_rate": 3.5e-7,
        "steady_state_rate_unit": "1/s",
        "time_to_rupture": 120,
        "time_to_rupture_unit": "h",
        "minimum_creep_strain_rate": 3.2e-7,
        "min_rate_unit": "1/s",
        "total_strain_at_rupture": 0.15,
        "stress_redistribution": "stress_redistribution.vtk",
        "necking_strain": 0.08,
        "creep_damage_field": "creep_damage.vtk"
      },
      "parameters": {
        "element_type": "C3D8R",
        "mesh_density": "axisymmetric_100x20",
        "mesh_refinement_gauge": true,
        "boundary_condition": "fixed_bottom_displacement_controlled_top",
        "solver_type": "static_implicit_with_creep",
        "creep_integration": "explicit_Euler",
        "creep_time_increment_initial": 1.0,
        "creep_time_increment_unit": "s",
        "creep_time_increment_max": 100,
        "creep_time_increment_max_unit": "s",
        "damage_model": "Kachanov-Rabotnov",
        "damage_initiation_strain": 0.05,
        "damage_evolution_rate": 3.0,
        "max_iterations": 200,
        "convergence_tolerance": 1e-6
      },
      "bridge_to_next": {
        "mapping_method": "Creep curve comparison with experimental data and Larson-Miller parameter",
        "data_transferred": [
          "creep_curve",
          "steady_state_creep_rate",
          "time_to_rupture",
          "creep_damage_field",
          "stress_redistribution"
        ]
      }
    }
  ],
  "reference": {
    "doi": "10.1016/j.actamat.2004.09.028",
    "authors": "Mishin Y, Asta M, Li J",
    "year": 2004,
    "journal": "Acta Materialia"
  },
  "expected_results": {
    "quantities": [
      {
        "name": "Vacancy formation energy",
        "value": 0.66,
        "unit": "eV",
        "tolerance": 5
      },
      {
        "name": "Diffusion activation energy",
        "value": 1.27,
        "unit": "eV",
        "tolerance": 8
      },
      {
        "name": "GB diffusion activation energy",
        "value": 0.85,
        "unit": "eV",
        "tolerance": 15
      },
      {
        "name": "Grain growth exponent n",
        "value": 3.0,
        "unit": "dimensionless",
        "tolerance": 10
      },
      {
        "name": "Steady-state creep rate",
        "value": 3.5e-7,
        "unit": "1/s",
        "tolerance": 30
      },
      {
        "name": "Creep stress exponent n",
        "value": 5.0,
        "unit": "dimensionless",
        "tolerance": 15
      }
    ]
  },
  "acceptance": {
    "overall_error_limit": 25
  }
}