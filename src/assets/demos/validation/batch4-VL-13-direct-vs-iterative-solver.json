  "solver": {
    "type": "static",
    "max_iterations": 1000,
    "convergence_tolerance": 1e-10
  },
  "theoretical": {
    "max_displacement": 0.0002,
    "max_stress": 6000000,
    "formula": "I = bh³/12 = 8.333e-6 m⁴; δ_exact = FL³/(3EI) = 2.0e-4 m; σ_exact = Mc/I = 6.0e6 Pa; Direct solver (Cholesky): factorization O(N·bw²), solve O(N·bw); Memory ~ N·bw; LU: factorization O(N·bw²), 2× memory of Cholesky; PCG: O(N·nnz_per_row·n_iter), Memory ~ O(N·nnz_per_row); AMG setup: O(N), solve: O(N·log(N)); Expected solve times: Direct 10k: 0.5s, 50k: 8s, 100k: 35s, 500k: 450s; Iterative 10k: 1.5s, 50k: 8s, 100k: 18s, 500k: 60s; Memory (GB): Direct 10k: 0.1, 50k: 1.5, 100k: 6, 500k: 120; Iterative 10k: 0.05, 50k: 0.3, 100k: 0.6, 500k: 3.5",
    "reference": "Saad, Y. Iterative Methods for Sparse Linear Systems; Davis, T.A. Direct Methods for Sparse Linear Systems"
