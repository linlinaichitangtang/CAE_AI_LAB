{
  "id": "VL-13",
  "name": "直接求解器vs迭代求解器对比",
  "nameEn": "Direct vs Iterative Solver Performance Comparison",
  "description": "验证直接求解器(Cholesky/LU分解)与迭代求解器(PCG/AMG预处理共轭梯度)在不同自由度规模下的求解效率和精度差异。采用四种模型规模：10000、50000、100000、500000自由度，均为标准悬臂梁结构。直接求解器在小规模问题上速度快且精度高，但内存消耗随DOF呈超线性增长(O(N^1.5)~O(N²))；迭代求解器内存消耗为O(N)，在大规模问题上优势明显。对比求解时间、内存占用和残差收敛历史，验证：(1)10000 DOF时直接法更快(<1s vs 2s)，(2)500000 DOF时迭代法更快(60s vs 300s)，(3)两者位移解误差<0.01%。",
  "category": "validation",
  "usage": "test",
  "difficulty": 4,
  "tags": ["solver_algorithm", "direct_solver", "iterative_solver", "pcg", "amg", "convergence", "performance"],
  "validation_type": "solver_algorithm",
  "test_config": {
    "baseline": {
      "description": "直接求解器(Cholesky分解)，10000 DOF基准模型",
      "bc_type": "fixed-free_cantilever",
      "material_type": "linear_elastic_steel",
      "mesh_density": 10
    },
    "variants": [
      {
        "description": "直接求解器(Cholesky分解)，50000 DOF",
        "bc_type": "fixed-free_cantilever",
        "material_type": "linear_elastic_steel",
        "mesh_density": 17
      },
      {
        "description": "直接求解器(LU分解)，100000 DOF",
        "bc_type": "fixed-free_cantilever",
        "material_type": "linear_elastic_steel",
        "mesh_density": 22
      },
      {
        "description": "直接求解器(LU分解)，500000 DOF",
        "bc_type": "fixed-free_cantilever",
        "material_type": "linear_elastic_steel",
        "mesh_density": 37
      },
      {
        "description": "迭代求解器(PCG+AMG预处理)，10000 DOF",
        "bc_type": "fixed-free_cantilever",
        "material_type": "linear_elastic_steel",
        "mesh_density": 10
      },
      {
        "description": "迭代求解器(PCG+AMG预处理)，50000 DOF",
        "bc_type": "fixed-free_cantilever",
        "material_type": "linear_elastic_steel",
        "mesh_density": 17
      },
      {
        "description": "迭代求解器(PCG+AMG预处理)，100000 DOF",
        "bc_type": "fixed-free_cantilever",
        "material_type": "linear_elastic_steel",
        "mesh_density": 22
      },
