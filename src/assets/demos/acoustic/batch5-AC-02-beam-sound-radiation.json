{
  "id": "AC-02",
  "name": "简支梁声辐射分析",
  "nameEn": "Simply Supported Beam Sound Radiation",
  "description": "分析简支钢梁在200Hz简谐激励下的声辐射特性。计算声辐射效率σ_rad和辐射声功率W。基于薄梁弯曲波理论，当弯曲波速等于声速时产生声辐射效率峰值（吻合频率）。验证辐射功率公式W=ρ₀c₀v²Sσ_rad，其中v为表面均方根速度，S为辐射面积。",
  "category": "acoustic",
  "usage": "learning",
  "difficulty": 2,
  "tags": ["sound-radiation", "simply-supported", "beam", "radiation-efficiency", "harmonic"],
  "geometry": {
    "type": "beam",
    "length": 0.5,
    "width": 0.03,
    "height": 0.005,
    "radius": null,
    "thickness": 0.005,
    "dimension": "3d"
  },
  "mesh": {
    "x_div": 30,
    "y_div": 6,
    "z_div": 4,
    "element_type": "C3D8"
  },
  "material": {
    "name": "Structural Steel",
    "elastic_modulus": 2.0e11,
    "poisson_ratio": 0.3,
    "density": 7800,
    "yield_stress": 2.5e8,
    "speed_of_sound": 5900,
    "bulk_modulus": 1.667e11
  },
  "boundaryConditions": {
    "fixed_face": "pin_supports",
    "load_type": "harmonic",
    "load_face": "beam_center_top",
    "load_magnitude": 100,
    "load_direction": "Y",
    "frequency_hz": 200,
    "temperature_bc": {}
  },
  "solver": {
    "type": "harmonic",
    "max_iterations": 100,
    "convergence_tolerance": 1e-6,
    "frequency_range": [20, 2000]
  },
  "theoretical": {
    "max_displacement": 2.5e-5,
    "max_stress": 1.2e7,
    "natural_frequency": 200,
    "formula": "W = rho_0 * c_0 * v_rms^2 * S * sigma_rad; sigma_rad for beam: function of ka and k_b*a",
    "reference": "Fahy & Gardonio, Sound and Structural Vibration, 2nd Ed., Ch.5"
  },
  "acceptance": {
    "frequency_error_limit": 5,
    "spl_error_limit": 3
  },
  "expected_results": {
    "quantities": [
      {
        "name": "radiation_efficiency_sigma_rad",
        "value": 0.012,
        "unit": "dimensionless",
        "tolerance": 10
      },
      {
        "name": "radiated_sound_power",
        "value": 1.8e-6,
        "unit": "W",
        "tolerance": 10
      },
      {
        "name": "surface_rms_velocity",
        "value": 0.005,
        "unit": "m/s",
        "tolerance": 10
      },
      {
        "name": "sound_pressure_level_at_1m",
        "value": 62,
        "unit": "dB",
        "tolerance": 5
      }
    ]
  }
}