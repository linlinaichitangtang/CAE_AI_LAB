{
  "id": "MD-02",
  "name": "Kriging代理模型",
  "nameEn": "Kriging Surrogate Model",
  "description": "构建Kriging代理模型近似高保真有限元分析。5个设计变量，采用拉丁超立方抽样（LHS）生成30个训练样本点。通过留一交叉验证（LOO-CV）评估代理模型精度，要求LOO-CV误差小于5%。验证代理模型在预测点的精度，并与高保真分析结果对比。分析Kriging模型的不确定性估计能力。",
  "category": "mdo",
  "usage": "learning",
  "difficulty": 3,
  "tags": ["Kriging", "surrogate-model", "LOO-CV", "LHS", "uncertainty"],
  "design_variables": [
    {
      "name": "变量1_长度",
      "lower_bound": 0.1,
      "upper_bound": 1.0,
      "initial": 0.5
    },
    {
      "name": "变量2_宽度",
      "lower_bound": 0.05,
      "upper_bound": 0.5,
      "initial": 0.25
    },
    {
      "name": "变量3_厚度",
      "lower_bound": 0.005,
      "upper_bound": 0.05,
      "initial": 0.025
    },
    {
      "name": "变量4_材料模量",
      "lower_bound": 70000000000.0,
      "upper_bound": 210000000000.0,
      "initial": 140000000000.0
    },
    {
      "name": "变量5_载荷",
      "lower_bound": 1000.0,
      "upper_bound": 10000.0,
      "initial": 5000.0
    }
  ],
  "objectives": [
    {
      "name": "最大位移",
      "type": "minimize"
    }
  ],
  "constraints": [
    {
      "name": "最大应力",
      "type": "inequality",
      "limit": 200000000.0
    }
  ],
  "optimization_method": {
    "type": "kriging",
    "population": 30,
    "generations": 1
  },
  "expected_results": {
    "quantities": [
      {
        "name": "LOO-CV误差",
        "value": 3.5,
        "unit": "%",
        "tolerance": 30
      },
      {
        "name": "训练样本数",
        "value": 30,
        "unit": "-",
        "tolerance": 0
      },
      {
        "name": "预测点相对误差",
        "value": 4.0,
        "unit": "%",
        "tolerance": 25
      },
      {
        "name": "R²决定系数",
        "value": 0.97,
        "unit": "-",
        "tolerance": 5
      }
    ]
  }
}
