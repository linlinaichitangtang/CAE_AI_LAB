  "name": "应力奇异评估",
  "nameEn": "Stress Singularity Assessment - Criterion Comparison",
  "description": "对比Von Mises、Tresca和最大主应力三种屈服准则在应力集中区域的差异。使用带中心圆孔的平板(200mm x 100mm x 5mm)受单向拉伸(σ=100MPa)，孔径20mm，理论应力集中系数K_t=3.0。在孔边应力集中点，三种准则给出不同结果：Von Mises应力约260MPa，Tresca应力约300MPa，最大主应力约300MPa。通过此测试案例评估不同应力准则在奇异点附近的数值表现，为工程判定提供参考。",
  "category": "postprocess",
  "usage": "test",
  "difficulty": 5,
  "tags": ["Von Mises", "Tresca", "最大主应力", "应力奇异", "应力集中", "准则对比"],
  "visualization": {
    "type": "comparison",
    "field": "stress",
    "color_map": "hot",
    "view_mode": "3d_solid",
    "animation": {
      "enabled": false,
      "frames": 1,
      "fps": 1,
      "format": "png_sequence"
    }
  },
  "source_simulation": {
    "type": "structural",
    "nodes": 32400,
