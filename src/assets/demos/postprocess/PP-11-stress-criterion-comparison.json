    "results_file": "results/postprocess/plate_hole_stress_criteria.dat"
  },
  "display_settings": {
    "title": "应力准则对比 - Von Mises / Tresca / Max Principal",
    "axis_labels": ["X (mm)", "Y (mm)", "Z (mm)"],
    "color_bar": {
      "min": 0,
      "max": 350,
      "label": "应力 (MPa)",
      "n_levels": 20
    },
    "camera": {
