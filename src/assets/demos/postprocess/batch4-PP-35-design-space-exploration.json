      { "name": "基频范围下界", "value": 45, "unit": "Hz", "tolerance": 10 },
      { "name": "基频范围上界", "value": 180, "unit": "Hz", "tolerance": 10 },
      { "name": "收敛代数", "value": 72, "unit": "代", "tolerance": 15 },
      { "name": "超体积指标(HV)", "value": 0.876, "unit": "", "tolerance": 5 },
