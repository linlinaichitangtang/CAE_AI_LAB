    "temperature_bc": {}
  },
  "solver": {
    "type": "static",
    "max_iterations": 200,
    "convergence_tolerance": 1e-08
  },
  "theoretical": {
    "max_displacement": 3.63e-04,
    "max_stress": 625000000.0,
    "formula": "σ_θ=pR/t=250MPa(筒体), σ_m=pR/(2t)=125MPa(轴向), SCF≈2.5 at nozzle-shell junction, σ_max=SCF×σ_θ=625MPa",
    "reference": "ASME BPVC Section VIII Div. 2; Megyesy, Pressure Vessel Handbook"
