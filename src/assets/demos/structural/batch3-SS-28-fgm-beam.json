    "elastic_modulus": 225000000000,
    "poisson_ratio": 0.3,
    "density": 3700,
    "yield_stress": 400000000,
    "thermal_expansion": 8.0e-6,
    "thermal_conductivity": 30,
    "specific_heat": 780
  },
  "boundaryConditions": {
