{
  "id": "SS-06",
  "name": "悬臂梁温度载荷分析",
  "nameEn": "Cantilever Beam Thermal Load Analysis",
  "description": "悬臂梁在均匀温升ΔT=100°C作用下的热应力分析。考虑两种工况：(1)完全约束条件下热应力σ=EαΔT=240MPa；(2)自由膨胀条件下轴向伸长量δ=αΔT·L=1.2mm。钢材线膨胀系数α=12×10⁻⁶/K。该算例用于验证有限元程序中热-力耦合分析的正确性，是热应力分析的基础案例。",
  "category": "structural",
  "usage": "learning",
  "difficulty": 2,
  "tags": [
    "热应力",
    "温度载荷",
    "热膨胀",
    "耦合分析"
  ],
  "geometry": {
    "type": "beam",
    "length": 1.0,
    "width": 0.1,
    "height": 0.1,
    "dimension": "3d"
  },
  "mesh": {
    "x_div": 20,
    "y_div": 2,
    "z_div": 2,
    "element_type": "C3D8"
  },
  "material": {
    "name": "Q235 Steel",
    "elastic_modulus": 200000000000.0,
    "poisson_ratio": 0.3,
    "density": 7850.0,
    "yield_stress": 235000000.0,
    "thermal_expansion": 1.2e-05,
    "thermal_conductivity": 50.0,
    "specific_heat": 490.0
  },
  "boundaryConditions": {
    "fixed_face": "x_min",
    "load_type": "thermal",
    "load_face": "",
    "load_magnitude": 0.0,
    "load_direction": "X",
    "temperature_bc": {
      "type": "uniform",
      "delta_T": 100.0
    }
  },
  "solver": {
    "type": "static",
    "max_iterations": 100,
    "convergence_tolerance": 1e-08
  },
  "theoretical": {
    "max_displacement": 0.0012,
    "max_stress": 240000000.0,
    "formula": "σ=EαΔT=200×10⁹×12×10⁻⁶×100=240MPa, δ=αΔT·L=1.2mm",
    "reference": "Boley & Weiner, Theory of Thermal Stresses, Ch. 1"
  },
  "acceptance": {
    "displacement_error_limit": 5.0,
    "stress_error_limit": 5.0
  },
  "expected_results": {
    "quantities": [
      {
        "name": "完全约束热应力",
        "value": 240000000.0,
        "unit": "Pa",
        "tolerance": 5.0
      },
      {
        "name": "自由端热膨胀量",
        "value": 0.0012,
        "unit": "m",
        "tolerance": 5.0
      },
      {
        "name": "温升",
        "value": 100.0,
        "unit": "K",
        "tolerance": 0.1
      }
    ]
  }
}