{
  "id": "SS-02",
  "name": "简支梁弯曲分析",
  "nameEn": "Simply Supported Beam Bending",
  "description": "两端简支梁在跨中受集中力F=1000N的弯曲分析。验证简支梁跨中挠度公式δ=FL³/(48EI)和最大弯曲应力σ=FL/(4Z)。简支梁是工程中最常见的结构形式之一，该算例用于验证有限元程序对简支边界条件的处理能力以及弯曲变形计算的准确性。",
  "category": "structural",
  "usage": "learning",
  "difficulty": 1,
  "tags": [
    "简支梁",
    "弯曲",
    "线性静力学",
    "跨中载荷"
  ],
  "geometry": {
    "type": "beam",
    "length": 1.0,
    "width": 0.1,
    "height": 0.1,
    "dimension": "3d"
  },
  "mesh": {
    "x_div": 20,
    "y_div": 2,
    "z_div": 2,
    "element_type": "C3D8"
  },
  "material": {
    "name": "Q235 Steel",
    "elastic_modulus": 200000000000.0,
    "poisson_ratio": 0.3,
    "density": 7850.0,
    "yield_stress": 235000000.0,
    "thermal_expansion": 1.2e-05,
    "thermal_conductivity": 50.0,
    "specific_heat": 490.0
  },
  "boundaryConditions": {
    "fixed_face": "x_min",
    "load_type": "point",
    "load_face": "x_mid",
    "load_magnitude": 1000.0,
    "load_direction": "Y",
    "temperature_bc": {}
  },
  "solver": {
    "type": "static",
    "max_iterations": 100,
    "convergence_tolerance": 1e-08
  },
  "theoretical": {
    "max_displacement": 1.25e-05,
    "max_stress": 1500000.0,
    "formula": "δ=FL³/(48EI), σ=FL/(4Z), Z=I/(h/2)=1.6667×10⁻⁴ m³",
    "reference": "Timoshenko, Mechanics of Materials, Eq. 6.28"
  },
  "acceptance": {
    "displacement_error_limit": 5.0,
    "stress_error_limit": 5.0
  },
  "expected_results": {
    "quantities": [
      {
        "name": "跨中挠度",
        "value": 1.25e-05,
        "unit": "m",
        "tolerance": 5.0
      },
      {
        "name": "跨中最大弯曲应力",
        "value": 1500000.0,
        "unit": "Pa",
        "tolerance": 5.0
      },
      {
        "name": "支座反力",
        "value": 500.0,
        "unit": "N",
        "tolerance": 1.0
      }
    ]
  }
}