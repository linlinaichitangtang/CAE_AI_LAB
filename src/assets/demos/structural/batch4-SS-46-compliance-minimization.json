        "unit": "-",
        "tolerance": 3
      },
      {
        "name": "载荷点位移 Load Point Displacement",
        "value": 0.085,
        "unit": "mm",
        "tolerance": 10
      },
      {
        "name": "优化迭代次数 Optimization Iterations",
        "value": 80,
        "unit": "-",
        "tolerance": 20
      }
    ]
  }
