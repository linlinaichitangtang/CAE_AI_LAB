      { "name": "第1道次轧制力", "value": 25000000, "unit": "N", "tolerance": 20 },
      { "name": "最终厚度", "value": 0.025, "unit": "m", "tolerance": 2 },
      { "name": "最大等效塑性应变", "value": 2.1, "unit": "-", "tolerance": 15 },
      { "name": "最大轧制温度", "value": 1400, "unit": "K", "tolerance": 8 },
