    "element_type": "DC3D8"
  },
  "material": {
    "name": "Low Carbon Steel (Q235)",
    "elastic_modulus": 200000000000,
    "poisson_ratio": 0.3,
    "density": 7850,
    "yield_stress": 235000000,
    "thermal_expansion": 12e-6,
    "thermal_conductivity": 50,
    "specific_heat": 500
  },
  "boundaryConditions": {
    "fixed_face": "",
    "load_type": "heat_flux",
    "load_face": "top_surface_weld_line",
    "load_magnitude": 0,
